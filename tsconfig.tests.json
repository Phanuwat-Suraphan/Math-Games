{
  // คอมไพล์เฉพาะตรรกะเกมเป็น CommonJS ให้ชุดทดสอบใน tests/ เรียกใช้ได้
  // ไม่รวมไฟล์ React เพราะชุดทดสอบไม่แตะหน้าจอ
  //
  // ใช้ไฟล์นี้แทน flag --ignoreConfig เพราะ flag นั้นมีเฉพาะ TypeScript รุ่นใหม่
  // ถ้าใช้ flag ชุดทดสอบจะรันไม่ได้บนเครื่องที่ลง TypeScript ตามที่โปรเจกต์กำหนด
  //
  // วิธีใช้: npx tsc -p tsconfig.tests.json --outDir /tmp/logic
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "rootDir": "src",
    "strict": true,
    // ต้องตรงกับ tsconfig.json ของแอป ไม่งั้นจะคอมไพล์ผ่านในเครื่อง
    // แล้วไปพังตอน CI ด้วย error ที่เห็นได้ตั้งแต่แรก
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // ไม่ดึง type ของ node หรือ react เข้ามา ตรรกะเกมไม่ได้ใช้
    "types": []
  },
  "include": [
    "src/types/**/*.ts",
    "src/data/**/*.ts",
    "src/utils/**/*.ts",
    "src/math/**/*.ts",
    "src/art/**/*.ts",
    "src/audio/**/*.ts",
    "src/components/art/duelArt.ts",
    "src/puzzles/**/*.ts",
    "src/roguelike/**/*.ts",
    "src/survivor/**/*.ts",
    "src/safezone/**/*.ts",
    "src/minigames/**/*.ts",
    "src/questionEngine/**/*.ts",
    "src/services/storage.ts",
    // สองไฟล์นี้ไม่มีชุดทดสอบเรียกใช้ แต่ใส่ไว้ให้คอมไพล์ในเครื่องได้
    // เพราะเป็นไฟล์ .ts ที่แตะ Web Audio ซึ่งเดิมต้องรอ CI ถึงจะรู้ว่าเรียกผิด
    "src/services/audioService.ts",
    "src/services/musicService.ts",
    "src/services/rewardService.ts",
    "src/services/questService.ts",
    "src/services/questionService.ts",
    "src/services/battleService.ts",
    "src/services/inventoryService.ts",
    "src/services/upgradeService.ts",
    "src/services/avatarService.ts",
    "src/services/perkService.ts",
    "src/services/recordService.ts",
    "src/services/storyService.ts",
    "src/battle/**/*.ts"
  ]
}
